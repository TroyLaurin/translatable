#!/usr/bin/env sh
set -eu

IMAGE="${1:-elixir:1.15.8-otp-26}"
PROJECT_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

docker run --rm -t \
  --user "$(id -u):$(id -g)" \
  -e HOME=/tmp/translatable-home \
  -e MIX_HOME=/tmp/translatable-mix \
  -e HEX_HOME=/tmp/translatable-hex \
  -v "$PROJECT_ROOT:/workspace" \
  -w /workspace \
  "$IMAGE" \
  sh -lc "mix local.hex --force && mix local.rebar --force && mix deps.get && mix precommit"
